[MAIN]
py-version = 3.10

[MESSAGES CONTROL]
disable =
    missing-module-docstring,
    missing-function-docstring,
    wrong-import-position,
    wrong-import-order,
    import-outside-toplevel,
    redefined-outer-name,
    unused-import,
    too-many-statements,
    broad-exception-caught,
    use-dict-literal,
    consider-using-with,
    multiple-statements,
    multiple-imports,
    reimported,

[TYPECHECK]
generated-members=setnchannels,setsampwidth,setframerate,writeframes

[BASIC]
good-names=SILENCE_CHUNKS,MAX_SECONDS,MIN_SPEECH_FRAMES,PRE_ROLL_CHUNKS,AUDIO_QUEUE_MAX,COOLDOWN_SECONDS,VAD_CALIBRATION_CHUNKS,VAD_MIN_THRESHOLD,VAD_NOISE_MULTIPLIER,TRANSLATION_CACHE_MAX,TTS_MEMORY_CACHE_MAX,pa,wf,qr,buf,tmp,proc,g,ph

[FORMAT]
max-line-length=100
